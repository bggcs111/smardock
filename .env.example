# 复制为 .env 后填入真实 Key 即可生效（.env 不要提交到仓库）

# ===== 向量化（阿里云百炼 DashScope）=====
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024

# 若想换成 OpenAI 兼容端点（OpenAI / SiliconFlow / 本地 vLLM / Ollama），改为：
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-xxxxxxxx

# ===== 问答模型（DeepSeek）=====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=DeepSeek-V4.1-Flash
LLM_TEMPERATURE=0.2

# ===== PII 脱敏（本地）=====
PII_NER_ENABLED=true
PII_REGEX_ENABLED=true
# 隐私模式是否严格脱敏：开启后回答与引用也保留占位符，不在本地还原真实信息。
# 普通模式不受此开关影响（普通模式全程不脱敏、不还原）。
PRIVACY_STRICT_REDACTION=true
# 隐私模式下给引用来源打码：文件名 / 本地路径 / 下载副本统一显示为「文档N」
PRIVACY_MASK_SOURCE=true
# 标签锚定识别（姓名/地址/机构/编号/出生日期），纯代码、无需模型，建议保持开启
PII_CONTEXT_ENABLED=true
# 额外要脱敏的字段名（逗号分隔）。这些字段一般不算强标识，按需开启：
# 例：PII_EXTRA_FIELDS=性别,职业类别,婚姻状况,民族
PII_EXTRA_FIELDS=
# 是否调用云端 LLM 为图表生成语义描述（默认关闭）
FIGURE_AI_DESCRIBE=false

# ===== 检索与切片 =====
CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K_PER_KB=4
TOP_K_TOTAL=8
RERANK_ENABLED=true

# ===== 服务 =====
SERVER_NAME=127.0.0.1
SERVER_PORT=7860
SHARE=false
# 启动后是否自动打开浏览器
INBROWSER=true
# 运行时临时目录（Gradio 上传中转等），退出服务时自动清空，默认 data/tmp
# TEMP_DIR=
